<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ remplace le splash `android:background` par l'API SplashScreen :
      sans ces attributs, le système affiche l'icône sur le fond blanc du thème
      par défaut. On impose donc le fond sombre et le glyphe de la marque.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/gitquest_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
